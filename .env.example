# EduTrace Environment Configuration (Example)
# Note: Keep server secrets out of client code. Never prefix private API keys with VITE_.

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini AI Configuration (Server-Side Only)
# Configure in hosting provider environment variables (e.g., Vercel / Cloud Run).
# If omitted or invalid, EduTrace automatically falls back to deterministic rule-based intelligence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Official APAAR Gateway Configuration (Optional, Server-Side Only)
# If omitted, EduTrace uses the deterministic MockApaarProvider for demo & testing.
APAAR_GATEWAY_URL=https://apisetu.gov.in/v1/apaar
APAAR_CLIENT_ID=
APAAR_API_KEY=
APAAR_INSTITUTION_CODE=

